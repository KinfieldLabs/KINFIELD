# Postgres (local, or a hosted one such as Neon or Supabase in production)
DATABASE_URL=postgres://localhost:5432/kinfield

# GitHub OAuth app: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:      http://localhost:3000
#   Callback URL:      http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local only: shows a "Dev sign-in" that skips GitHub. Ignored in production builds.
DEV_LOGIN=1

# Open dataset (published nightly by the /api/cron/publish job in vercel.json)
# Vercel sends CRON_SECRET as a bearer token; any long random string.
CRON_SECRET=
# GitHub App that writes to the dataset repository
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
DATASET_REPO=KinfieldLabs/kinfield-datasets
# Local only: where a dry run (?dry=1) writes the dataset
DATASET_OUT_DIR=
